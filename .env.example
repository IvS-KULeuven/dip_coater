# Dip Coater configuration
# Copy this file to .env and adjust to your setup.
# Load with: set -a && source .env && set +a && dip-coater

DIP_COATER_DRIVER=TMC5160
DIP_COATER_INTERFACE=usb_tmcl
DIP_COATER_PORT=/dev/tty.usbmodemTMCEVAL1
# DIP_COATER_LOG_LEVEL=INFO
# DIP_COATER_SETUP=
# DIP_COATER_MM_PER_REVOLUTION=
# DIP_COATER_GEARBOX_RATIO=
# DIP_COATER_STEPS_PER_REV=
# DIP_COATER_USE_DUMMY_DRIVER=false
# DIP_COATER_INVERT_DIRECTION=false
# DIP_COATER_HOME_DIRECTION=
